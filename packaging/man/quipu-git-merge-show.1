.TH QUIPU-GIT-MERGE-SHOW 1 "" quipu "Quipu Manual"
.SH NAME
quipu\-git\-merge\-show \- Show a qpack\*(Aqs pending merge decisions in the standard layout
.SH SYNOPSIS
\fBquipu git\-merge show\fR [\fB\-\-db\fR] [\fB\-\-format\fR] [\fB\-h\fR|\fB\-\-help\fR] <\fIqpack\-dir\fR> 
