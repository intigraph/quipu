.TP
\fB\-\-section\fR \fI<VALUE>\fR

.TP
\fB\-\-brief\fR

.TP
\fB\-\-static\fR

.TP
\fB\-\-json\fR

.TP
\fB\-h\fR, \fB\-\-help\fR
