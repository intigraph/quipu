.TP
\fB\-\-shapes\fR \fI<VALUE>\fR

.TP
\fB\-\-queries\fR \fI<VALUE>\fR

.TP
\fB\-\-repo\fR \fI<VALUE>\fR

.TP
\fB\-\-repo\-sha\fR \fI<VALUE>\fR

.TP
\fB\-\-model\-id\fR \fI<VALUE>\fR

.TP
\fB\-\-model\-version\fR \fI<VALUE>\fR

.TP
\fB\-\-destination\fR \fI<VALUE>\fR

.TP
\fB\-\-format\fR \fI<VALUE>\fR

.TP
\fB\-\-with\-vectors\fR

.TP
\fB\-\-full\fR

.TP
\fB\-\-allow\-missing\-embedding\-recipe\fR

.TP
\fB\-h\fR, \fB\-\-help\fR
Print help
.TP
[\fIgraph\-iri\fR]

