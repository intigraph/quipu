.TH QUIPU-SHARE 1 "" quipu "Quipu Manual"
.SH NAME
quipu\-share \- Write a portable share of a graph, scope or project
.SH SYNOPSIS
\fBquipu share\fR [\fB\-\-db\fR] [\fB\-\-output\fR] [\fB\-\-graph\fR] [\fB\-\-group\-id\fR] [\fB\-\-construct\fR] [\fB\-\-shapes\fR] [\fB\-\-queries\fR] [\fB\-\-alignments\fR] [\fB\-\-parent\-share\fR] [\fB\-\-since\fR] [\fB\-\-destination\fR] [\fB\-\-pack\-dir\fR] [\fB\-\-actor\fR] [\fB\-\-attest\-key\fR] [\fB\-\-attest\-issued\-at\fR] [\fB\-\-attest\-ttl\fR] [\fB\-\-attest\-agent\fR] [\fB\-\-attest\-session\fR] [\fB\-\-attest\-introducer\fR] [\fB\-\-attest\-nonce\fR] [\fB\-\-pointers\fR] [\fB\-\-no\-shapes\fR] [\fB\-\-no\-queries\fR] [\fB\-\-turtle\fR] [\fB\-\-attest\fR] [\fB\-\-project\fR] [\fB\-h\fR|\fB\-\-help\fR] [\fIsubcommands\fR]
