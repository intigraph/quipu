# Violations of schema.json that TerminusDB itself would refuse at commit time:
# missing mandatory name, an out-of-enum status, three emails (max 2), a non-decimal age.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <terminusdb:///schema#> .
<terminusdb:///data/Person/Nobody> a schema:Person ;
  schema:age "old"^^xsd:string ;
  schema:status <terminusdb:///schema#Status/missing> ;
  schema:emails "a@example.org", "b@example.org", "c@example.org" ;
  schema:nicknames <http://www.w3.org/1999/02/22-rdf-syntax-ns#nil> .
