# Instance graph for schema.json (GET /api/triples/<org>/<db>/local/branch/main/instance).
# Lexical-key IRIs follow idgen_lexical (json.pl:454-461): <base><Class>/<encoded key values joined by +>.
# Enum values are the schema IRIs <Status>/<value>; List values are rdf:List Cons cells (json.pl:2116-2136).
# sys:JSON values are linked nodes typed sys:JSON under terminusdb:///json/JSON/SHA1/ with json: predicates
# (json.pl:14385-14420); a sys:Unit value is rdf:nil (json_triple_, Value = []).
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <terminusdb:///schema#> .
@prefix data: <terminusdb:///data/> .
@prefix sys: <http://terminusdb.com/schema/sys#> .
@prefix json: <http://terminusdb.com/schema/json#> .

<terminusdb:///data/Person/Ada%20Lovelace> a schema:Person ;
  schema:name "Ada Lovelace"^^xsd:string ;
  schema:age "36"^^xsd:decimal ;
  schema:status <terminusdb:///schema#Status/active> ;
  schema:emails "ada@example.org"^^xsd:string ;
  schema:friends <terminusdb:///data/Person/Grace%20Hopper> ;
  schema:nicknames data:Cons\/n1 ;
  schema:homepage "https://example.org/ada"^^<http://terminusdb.com/schema/xdd#url> ;
  schema:profile <terminusdb:///json/JSON/SHA1/5f6f1ff2d0ceea4cc50351637eeaf3bc469f15df> .
<terminusdb:///json/JSON/SHA1/5f6f1ff2d0ceea4cc50351637eeaf3bc469f15df> a sys:JSON ;
  json:some <terminusdb:///json/JSON/SHA1/9c375c0d2cd0bd7949e387cc28dafbc1c5be8de3> .
<terminusdb:///json/JSON/SHA1/9c375c0d2cd0bd7949e387cc28dafbc1c5be8de3> a sys:JSON ;
  json:random "stuff"^^xsd:string ;
  json:that "2.0"^^xsd:double .
data:Cons\/n1 a rdf:List ; rdf:first "The Enchantress of Numbers"^^xsd:string ; rdf:rest rdf:nil .

<terminusdb:///data/Person/Grace%20Hopper> a schema:Person ;
  schema:name "Grace Hopper"^^xsd:string ;
  schema:status <terminusdb:///schema#Status/retired> ;
  schema:emails "grace@example.org"^^xsd:string, "amazing.grace@example.org"^^xsd:string ;
  schema:nicknames rdf:nil ;
  schema:profile <terminusdb:///json/JSON/SHA1/9c375c0d2cd0bd7949e387cc28dafbc1c5be8de3> ;
  schema:contact <terminusdb:///data/Person/Grace%20Hopper/contact/Contact/r1> .
<terminusdb:///data/Person/Grace%20Hopper/contact/Contact/r1> a schema:Contact ;
  schema:none rdf:nil .

<terminusdb:///data/Team/Analytical%20Engines> a schema:Team ;
  schema:name "Analytical Engines"^^xsd:string ;
  schema:members <terminusdb:///data/Person/Ada%20Lovelace>, <terminusdb:///data/Person/Grace%20Hopper> ;
  schema:lead <terminusdb:///data/Person/Ada%20Lovelace> .
