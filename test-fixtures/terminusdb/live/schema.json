[
  { "@type": "@context", "@base": "terminusdb:///data/", "@schema": "terminusdb:///schema#" },
  { "@type": "Enum", "@id": "Status", "@value": ["active", "retired"] },
  { "@type": "Class", "@id": "Entity", "@abstract": [], "name": "xsd:string" },
  { "@type": "Class", "@id": "Person", "@inherits": "Entity",
    "@key": { "@type": "Lexical", "@fields": ["name"] },
    "age": { "@type": "Optional", "@class": "xsd:decimal" },
    "status": "Status",
    "friends": { "@type": "Set", "@class": "Person" },
    "emails": { "@type": "Set", "@class": "xsd:string", "@min_cardinality": 1, "@max_cardinality": 2 },
    "nicknames": { "@type": "List", "@class": "xsd:string" },
    "scores": { "@type": "Array", "@class": "xsd:integer" },
    "homepage": { "@type": "Optional", "@class": "xdd:url" },
    "profile": { "@type": "Optional", "@class": "sys:JSON" },
    "contact": { "@type": "Optional", "@class": "Contact" } },
  { "@type": "Class", "@id": "Team", "@key": { "@type": "Lexical", "@fields": ["name"] },
    "name": "xsd:string",
    "lead": "Entity",
    "members": { "@type": "Cardinality", "@class": "Person", "@min_cardinality": 1, "@max_cardinality": 5 } },
  { "@type": "TaggedUnion", "@id": "Contact", "@subdocument": [], "@key": { "@type": "Random" },
    "email": "xsd:string", "phone": "xsd:string", "none": "sys:Unit" }
]
