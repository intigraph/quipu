# Opt-in vocabulary for derived grouping packs. Loading is a separate action.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix quipu: <https://quipu.dev/ontology/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

quipu:DerivedGroupShape a sh:NodeShape ;
    sh:targetClass quipu:Group ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path quipu:size ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ;
    sh:property [ sh:path quipu:labelBasis ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path prov:wasGeneratedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

quipu:GroupingRunShape a sh:NodeShape ;
    sh:targetClass quipu:GroupingRun ;
    sh:property [ sh:path quipu:parameters ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .
