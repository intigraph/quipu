{"version": 2, "width": 65, "height": 14, "title": "Quipu | insert a fact, watch the graph change", "env": {"TERM": "dumb"}}
[0.0, "o", "\u001b[2J\u001b[H$ cat ada.ttl\r\n@prefix : <urn:demo:> .\r\n:Ada :studies :Engine .\r\n"]
[3.0, "o", "\u001b[2J\u001b[H$ quipu knot ada.ttl --db demo.db\r\nknotted 1 facts from ada.ttl (tx 1)\r\n"]
[6.0, "o", "\u001b[2J\u001b[H$ quipu read 'SELECT ?who ?what WHERE { ?who <urn:demo:studies> \r\n?what }' --db demo.db\r\nwho     what\r\n----------------------------------------\r\nurn:demo:Ada    urn:demo:Engine\r\n\r\n1 results\r\n"]
[10.0, "o", "\u001b[2J\u001b[H$ cat babbage.ttl\r\n@prefix : <urn:demo:> .\r\n:Babbage :designed :Engine .\r\n"]
[13.0, "o", "\u001b[2J\u001b[H$ quipu knot babbage.ttl --db demo.db\r\nknotted 1 facts from babbage.ttl (tx 2)\r\n"]
[16.0, "o", "\u001b[2J\u001b[H$ quipu read 'SELECT ?s ?p ?o WHERE { ?s ?p ?o }' --db demo.db\r\ns       p       o\r\n------------------------------------------------------------\r\nurn:demo:Ada    urn:demo:studies        urn:demo:Engine\r\nurn:demo:Babbage        urn:demo:designed       urn:demo:Engine\r\n\r\n2 results\r\n"]
[20.0, "o", "\u001b[2J\u001b[H$ quipu read 'SELECT ?s ?p ?o WHERE { ?s ?p ?o }' --tx 1 --db \r\ndemo.db\r\ns       p       o\r\n------------------------------------------------------------\r\nurn:demo:Ada    urn:demo:studies        urn:demo:Engine\r\n\r\n1 results\r\n"]
