
# Three-way merge for beads JSONL. The driver is `merge.beads`, defined by
# aegis scripts/install-beads-merge-driver.sh (aegis-h7xuql) and implemented by
# scripts/beads-jsonl-merge-driver.py.
#
# It is NOT `bd merge`: bd was retired in the 2026-08-29 clbx2 cutover, and neither
# bd nor br has ever had a `merge` subcommand (`br merge` -> unrecognized subcommand).
# If `merge.beads` is undefined, git does NOT warn -- it silently falls back to its
# TEXT merge and writes CONFLICT MARKERS into this file, which `br sync --import-only`
# then rejects under a guard that cannot be bypassed. Check with:
#     git config --get merge.beads.driver
.beads/issues.jsonl merge=beads

# Local context is supplied by `quipu git-merge REF`; CI checks without a driver.
**/pendant/export.nt merge=quipu
**/pendant/shapes.ttl merge=quipu
**/pendant/manifest.json merge=quipu
**/pendant/manifest.ttl merge=quipu
# Legacy pack directory remains an accepted alias.
**/qpack/export.nt merge=quipu
**/qpack/shapes.ttl merge=quipu
**/qpack/manifest.json merge=quipu
**/qpack/manifest.ttl merge=quipu

# Readable pack diffs: `git diff` shows facts grouped by labelled entity when
# `git config diff.quipu.textconv "quipu diff-textconv"` is set. Without that
# config the attribute is inert and Git diffs the raw lines as before.
*.nt diff=quipu
*.nq diff=quipu

# Preserve the literal PTY recording without relaxing other whitespace checks.
docs/probes/pr-demos/inferred-registry-filter/output.log whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/demos/store-ownership/output.log whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# quipu-docgen output (aegis-t7h): regenerate, do not edit.
packaging/man/** linguist-generated=true
packaging/completions/** linguist-generated=true
